[Unit]
Description=Ingstr — incremental document ingestion run for org %i
Documentation=https://github.com/OneMoreRabbit/ingstr-app
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# %i is the org: `systemctl start ingstr-ingest@arc`.
#
# The ORG SEGMENT is not optional. One org = one directory holding
# compose.yml, config.yml and secrets.env together: compose.yml binds its own
# directory to /etc/ingstr INSIDE the container (so config.yml must sit beside
# it), and the compose project name — the directory name — is what gives each
# org its own state volume. A unit pointing at the parent directly cannot run
# a second org.
#
# /etc/ingstr is the CONTAINER path, not a host path. The host parent below is
# estate-manage's choice, and on otter today it is /home/otter/docker/ingstr/
# (measured 2026-11-12). Change these two lines to match wherever it actually
# lives; nothing in ingstr depends on the parent.
User=otter
WorkingDirectory=/home/otter/docker/ingstr/%i

# No -f: compose reads compose.yml from WorkingDirectory, which is what keeps
# the project name per-org. -T because there is no terminal under systemd.
#
# This is the ORDINARY run. It takes no --full and no --wait-for-lock: if a
# full run is in progress it gives way at once and exits 0, which is correct
# — another run is already doing the work.
#
# The NIGHTLY unit is the other one, and it must pass BOTH --full and
# --wait-for-lock <seconds>. Without the wait it does not wait at all and
# fails with exit 5. How long is worth waiting is a property of the schedule,
# which is why it is declared here rather than built into ingstr.
#
# DO NOT USE Conflicts= BETWEEN THE TWO UNITS. Conflicts= STOPS the other
# unit rather than refusing the new one, so the unit that starts second kills
# the one already running. On otter the one nightly full run due since the
# restore was stopped a second after it started, and it would have been every
# night after it, with nothing saying so. From v0.2.3 ingstr refuses for
# itself, but a unit-level lock is still worth having so no pointless
# container is started.
#
# AND NO --expect-removals, EVER, IN A UNIT. That flag lets a run remove more
# passages than the guard would allow, and it exists to be typed by hand, for
# one run, by someone who has looked at a --dry-run first. In a unit it would
# stand for "whatever you were about to delete, do it" — on a timer, every
# night, unattended. If a removal is refused, the fix is a person reading the
# counts, not a bigger number in this file.
ExecStart=/usr/bin/docker compose --env-file secrets.env run --rm -T ingstr ingest --org %i
StandardOutput=journal
StandardError=journal

# Don't pile up overlapping runs. If a previous invocation is still
# running when the .path unit fires again, the new request is dropped.
# Use `Restart=on-failure` only if partial-failure exit code 3 should retry.

[Install]
WantedBy=multi-user.target
